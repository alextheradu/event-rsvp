---
import { count, eq } from "drizzle-orm";
import Base from "../../layouts/Base.astro";
import { db } from "../../lib/db";
import { forms, rsvps } from "../../lib/schema";

const { slug } = Astro.params;
const user = Astro.locals.user;

const form = await db.select().from(forms).where(eq(forms.slug, slug!)).get();

if (!form) {
	return new Response("Not found", { status: 404 });
}

if (!form.isPublic && (!user || form.creatorId !== user.id)) {
	return new Response("Not found", { status: 404 });
}

const total =
	(
		await db
			.select({ value: count() })
			.from(rsvps)
			.where(eq(rsvps.formId, form.id))
			.get()
	)?.value ?? 0;

const isManager =
	user &&
	(user.id === form.creatorId || user.slackId === import.meta.env.ADMIN_ID);
---

<Base
  title={`${form.title} - Stats`}
  description={`${total} ${total === 1 ? 'person' : 'people'} RSVP'd for ${form.title}`}
>
  <div class="max-w-2xl mx-auto space-y-4">
    <a href={isManager ? `/${slug}/manage` : `/${slug}`} class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">
      {isManager ? 'Back to manage' : 'Back to form'}
    </a>
    <h1 class="text-2xl font-bold tracking-tight">{form.title}</h1>
    <p class="text-zinc-400">
      {total} {total === 1 ? 'person' : 'people'} RSVP'd
    </p>
    {form.slackChannelId && (
      <a
        href={`https://hackclub.slack.com/archives/${form.slackChannelId}`}
        class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-200 transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        Join the Slack channel
      </a>
    )}
  </div>
</Base>
