---
import Base from '../layouts/Base.astro';
import { db } from '../lib/db';
import { forms, rsvps } from '../lib/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;

let myForms: (typeof forms.$inferSelect)[] = [];
let myRsvps: { rsvp: typeof rsvps.$inferSelect; form: typeof forms.$inferSelect }[] = [];

if (user) {
  myForms = await db
    .select()
    .from(forms)
    .where(eq(forms.creatorId, user.id))
    .orderBy(desc(forms.createdAt));

  const rsvpRows = await db
    .select()
    .from(rsvps)
    .innerJoin(forms, eq(rsvps.formId, forms.id))
    .where(eq(rsvps.userId, user.id))
    .orderBy(desc(rsvps.createdAt));

  myRsvps = rsvpRows.map((r) => ({ rsvp: r.rsvps, form: r.forms }));
}
---

<Base>
  {user ? (
    <div class="max-w-2xl mx-auto space-y-10">
      <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>

      {myForms.length > 0 && (
        <section>
          <h2 class="text-sm font-medium text-zinc-500 uppercase tracking-wide mb-3">Your Forms</h2>
          <div class="space-y-2">
            {myForms.map((form) => (
              <a
                href={`/${form.slug}/manage`}
                class="block p-4 bg-zinc-900/50 rounded-xl border border-zinc-800/60 hover:border-zinc-700/60 transition-colors"
              >
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-medium">{form.title}</h3>
                    <p class="text-sm text-zinc-500 mt-0.5">/{form.slug}</p>
                  </div>
                  <span
                    class:list={[
                      'text-xs px-2.5 py-1 rounded-full',
                      form.isOpen
                        ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                        : 'bg-zinc-800 text-zinc-500',
                    ]}
                  >
                    {form.isOpen ? 'Open' : 'Closed'}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section>
        <h2 class="text-sm font-medium text-zinc-500 uppercase tracking-wide mb-3">Your RSVPs</h2>
        {myRsvps.length === 0 ? (
          <p class="text-zinc-600 text-sm py-8 text-center">No RSVPs yet.</p>
        ) : (
          <div class="space-y-2">
            {myRsvps.map(({ rsvp, form }) => (
              <a
                href={`/${form.slug}`}
                class="block p-4 bg-zinc-900/50 rounded-xl border border-zinc-800/60 hover:border-zinc-700/60 transition-colors"
              >
                <h3 class="font-medium">{form.title}</h3>
                <p class="text-sm text-zinc-500 mt-0.5">
                  RSVP'd {rsvp.createdAt.toLocaleDateString()}
                </p>
              </a>
            ))}
          </div>
        )}
      </section>
    </div>
  ) : (
    <div class="text-center py-24 max-w-md mx-auto">
      <h1 class="text-4xl font-bold tracking-tight mb-3">RSVP</h1>
      <p class="text-zinc-400 text-lg mb-10 leading-relaxed">
        Quick RSVPs for You Ship, We Ship programs. Create a form, share the link, collect responses.
      </p>
      <a
        href="/auth/login"
        class="inline-block bg-primary text-white px-6 py-3.5 rounded-xl hover:bg-primary-dark transition-all font-medium shadow-lg shadow-primary/20 hover:shadow-primary/30"
      >
        Sign in to get started
      </a>
    </div>
  )}
</Base>
