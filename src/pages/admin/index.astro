---
import { count, eq } from "drizzle-orm";
import Base from "../../layouts/Base.astro";
import { db } from "../../lib/db";
import { forms, rsvps, users } from "../../lib/schema";

const user = Astro.locals.user;

if (!user || user.slackId !== import.meta.env.ADMIN_ID) {
	return new Response("Not found", { status: 404 });
}

const allUsers = await db.select().from(users).orderBy(users.createdAt);

const allForms = await db
	.select({
		id: forms.id,
		slug: forms.slug,
		title: forms.title,
		isOpen: forms.isOpen,
		createdAt: forms.createdAt,
		creatorName: users.name,
		rsvpCount: count(rsvps.id),
	})
	.from(forms)
	.leftJoin(users, eq(forms.creatorId, users.id))
	.leftJoin(rsvps, eq(forms.id, rsvps.formId))
	.groupBy(forms.id)
	.orderBy(forms.createdAt);
---

<Base title="Admin">
  <div class="max-w-2xl mx-auto space-y-10">
    <h1 class="text-2xl font-bold tracking-tight">Admin</h1>

    <section class="space-y-3">
      <h2 class="text-sm font-medium text-zinc-500 uppercase tracking-wide">
        Users <span class="text-zinc-700 normal-case font-normal">({allUsers.length})</span>
      </h2>
      <div class="space-y-1.5">
        {allUsers.map((u) => (
          <div class="flex items-center gap-3 p-3.5 bg-zinc-900/50 rounded-xl border border-zinc-800/60">
            {u.avatarUrl ? (
              <img src={u.avatarUrl} alt="" class="w-8 h-8 rounded-full shrink-0" />
            ) : (
              <div class="w-8 h-8 rounded-full bg-zinc-800 flex items-center justify-center text-sm text-zinc-500 font-medium shrink-0">
                {u.name.charAt(0).toUpperCase()}
              </div>
            )}
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate">{u.name || <span class="text-zinc-600 italic">unnamed</span>}</p>
              <p class="text-xs text-zinc-600">{u.slackId}</p>
            </div>
            <form method="POST" action="/api/admin">
              <input type="hidden" name="userId" value={u.id} />
              <input type="hidden" name="isAllowed" value={u.isAllowed ? '0' : '1'} />
              <button
                type="submit"
                class:list={[
                  'text-xs px-2.5 py-1 rounded-full border transition-colors',
                  u.isAllowed
                    ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20 hover:bg-red-500/10 hover:text-red-400 hover:border-red-500/20'
                    : 'bg-zinc-800 text-zinc-500 border-zinc-700 hover:bg-emerald-500/10 hover:text-emerald-400 hover:border-emerald-500/20',
                ]}
              >
                {u.isAllowed ? 'Allowed' : 'Blocked'}
              </button>
            </form>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-medium text-zinc-500 uppercase tracking-wide">
        Forms <span class="text-zinc-700 normal-case font-normal">({allForms.length})</span>
      </h2>
      <div class="space-y-1.5">
        {allForms.map((f) => (
          <a
            href={`/${f.slug}/manage`}
            class="flex items-center gap-3 p-3.5 bg-zinc-900/50 rounded-xl border border-zinc-800/60 hover:border-zinc-700/60 transition-colors"
          >
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate">{f.title}</p>
              <p class="text-xs text-zinc-600">/{f.slug} · {f.creatorName} · {f.rsvpCount} RSVPs</p>
            </div>
            <span class:list={[
              'text-xs px-2.5 py-1 rounded-full shrink-0',
              f.isOpen
                ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                : 'bg-zinc-800 text-zinc-500',
            ]}>
              {f.isOpen ? 'Open' : 'Closed'}
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
