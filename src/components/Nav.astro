---
interface Props {
	user: App.Locals["user"];
	minimal?: boolean;
}

const { user, minimal = false } = Astro.props;
const eligible = !user || import.meta.env.DEV || user.isAllowed;
---

<nav class="border-b border-zinc-800/60 px-4 py-3">
  <div class="max-w-2xl mx-auto flex items-center justify-between">
    <a href="/" class="text-base font-semibold tracking-tight hover:text-zinc-300 transition-colors">RSVP</a>
    {!minimal && (
      <div class="flex items-center gap-4">
        {user ? (
          <>
            {eligible ? (
              <a href="/new" class="text-sm bg-primary text-white px-3 py-1.5 rounded-lg hover:bg-primary-dark transition-colors font-medium">New form</a>
            ) : (
              <span class="text-sm bg-zinc-800 text-zinc-600 px-3 py-1.5 rounded-lg cursor-not-allowed">New form</span>
            )}
            <div class="flex items-center gap-2.5">
              {user.avatarUrl ? (
                <img src={user.avatarUrl} alt="" class="w-6 h-6 rounded-full" />
              ) : (
                <div class="w-6 h-6 rounded-full bg-zinc-800 flex items-center justify-center text-[11px] text-zinc-500 font-medium">
                  {user.name.charAt(0).toUpperCase()}
                </div>
              )}
              <span class="text-sm text-zinc-400 hidden sm:inline max-w-30 truncate">{user.name}</span>
              <a href="/auth/logout" class="text-sm text-zinc-600 hover:text-zinc-300 transition-colors">Sign out</a>
            </div>
          </>
        ) : (
          <a href="/auth/login" class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors">Sign in</a>
        )}
      </div>
    )}
  </div>
</nav>
