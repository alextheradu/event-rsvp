DATABASE_URL=./data/rsvp.db
SESSION_SECRET=generate-a-random-string-at-least-32-chars

# The OAuth callback registered with Hack Club Auth is <PUBLIC_URL>/oauth/callback
# — in production, https://rsvp.alexradu.co/oauth/callback. It must match the
# registered value exactly or token exchange fails with a redirect_uri mismatch.
# NEVER put real values in this file — it is tracked by git. Real credentials go in
# .env, which is gitignored.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Public origin(s) users actually browse to. Comma-separated.
# Used for Slack link unfurling AND for the Next.js Server Actions origin allowlist.
# If this does not match the origin in the browser's address bar, every mutation
# (RSVP, create form, save settings) fails in production while working in dev.
PUBLIC_URL=https://rsvp.alexradu.co

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

ADMIN_ID=
