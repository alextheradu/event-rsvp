DATABASE_URL=./data/rsvp.db
SESSION_SECRET=generate-a-random-string-at-least-32-chars

# The OAuth callback registered with Hack Club Auth is <PUBLIC_URL>/oauth/callback
# — in production, https://rsvp.alexradu.co/oauth/callback. The app derives that path
# from the incoming request, so it must match the registered value exactly or token
# exchange fails with a redirect_uri mismatch.
# NEVER put real values in this file — it is tracked by git. Real credentials go in
# .env, which is gitignored.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=

# Public origin(s) users actually browse to. Comma-separated; the first is canonical.
# Three things depend on this, and all three break quietly if it is wrong:
#   - Slack link unfurling (og:url resolution)
#   - the Next.js Server Actions origin allowlist — a mismatch makes every mutation
#     (RSVP, create form, save settings) fail in production while working in dev
#   - the OAuth redirect_uri sent to Hack Club Auth
PUBLIC_URL=https://rsvp.alexradu.co

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

ADMIN_ID=

PANGOLIN_ENDPOINT=
NEWT_ID=
NEWT_SECRET=
